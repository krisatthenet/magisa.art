# Public URL of the deployed backend (Railway). Leave blank for local dev (uses Vite proxy).
# Example: VITE_API_URL=https://magisa-art-production.up.railway.app
VITE_API_URL=

# PocketBase URL (data + auth + admin UI).
# Example: VITE_PB_URL=https://pocketbase-production-8554.up.railway.app
VITE_PB_URL=https://pocketbase-production-8554.up.railway.app

# Server-side PocketBase proxy target for the Railway/Node service.
PB_URL=https://pocketbase-production-8554.up.railway.app

# SMTP credentials for order email notifications (optional, used by the backend).
# Without these, orders are still saved to server/data/orders.json.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Support AI bot. Leave OPENAI_API_KEY blank to use the built-in mock responder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
